{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/lordcheetah/Academician/schemas/project.schema.json",
  "title": "Academician project config",
  "description": "Written to <project>/.academician/project.json when a project is created.",
  "type": "object",
  "required": ["slug", "title", "visibility", "output_kind"],
  "additionalProperties": false,
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string" },
    "visibility": { "enum": ["private", "public"] },
    "output_kind": {
      "enum": ["empirical-paper", "literature-review", "position-paper", "technical-report", "case-study"]
    },
    "audience": { "type": "string" },
    "topics": { "type": "array", "items": { "type": "string" } },
    "gates": {
      "description": "A preset name or an explicit gate list.",
      "oneOf": [
        { "enum": ["minimal", "standard", "all"] },
        {
          "type": "array",
          "items": { "enum": ["scope", "plan", "evidence", "outline", "draft", "final", "ship"] }
        }
      ]
    },
    "max_iterations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan": { "type": "integer", "minimum": 1 },
        "research": { "type": "integer", "minimum": 1 },
        "draft": { "type": "integer", "minimum": 1 },
        "review": { "type": "integer", "minimum": 1 }
      }
    },
    "min_sources": { "type": "integer", "minimum": 1 },
    "exports": {
      "type": "array",
      "items": { "enum": ["markdown", "pdf", "docx", "latex"] }
    },
    "citation_style": { "type": "string" },
    "builds_on": {
      "description": "Slugs of earlier projects this one extends.",
      "type": "array",
      "items": { "type": "string" }
    },
    "created": { "type": "string", "format": "date" }
  }
}
