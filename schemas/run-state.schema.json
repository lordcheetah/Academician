{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/lordcheetah/Academician/schemas/run-state.schema.json",
  "title": "Academician run state",
  "description": "Authoritative pipeline position. Written only by scripts/acad.mjs.",
  "type": "object",
  "required": ["version", "stage", "status"],
  "properties": {
    "version": { "const": 1 },
    "stage": {
      "enum": ["intake", "plan", "research", "evidence-check", "outline", "draft",
               "draft-check", "write", "review", "edit", "ship", "complete"]
    },
    "status": { "enum": ["running", "awaiting-gate", "blocked", "stopped", "complete"] },
    "iterations": {
      "type": "object",
      "properties": {
        "plan": { "type": "integer", "minimum": 0 },
        "research": { "type": "integer", "minimum": 0 },
        "draft": { "type": "integer", "minimum": 0 },
        "review": { "type": "integer", "minimum": 0 }
      }
    },
    "gates_passed": { "type": "array", "items": { "type": "string" } },
    "blocked_reason": { "type": "string" },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "loop": { "type": "string" },
          "iteration": { "type": "integer" },
          "gate": { "type": "string" },
          "decision": { "enum": ["approve", "revise", "reject"] },
          "note": { "type": "string" }
        }
      }
    },
    "updated": { "type": ["string", "null"], "format": "date-time" }
  }
}
