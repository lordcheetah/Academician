# Academician is the public loop. Research projects live in their own sibling
# repos and are never committed here. The user's registry is private and lives
# at ~/.academician/registry.json, not in this repo.
#
# These patterns are anchored with a leading slash on purpose: an unanchored
# "commons/" would also match templates/commons/, which must be committed.
/registry.json
/config.json
/projects/
/commons/
*.local.json

# Plugin enablement is per-machine, and academic-research-skills is CC BY-NC.
# Cloners should opt in themselves (see README) rather than inherit it.
/.claude/

.DS_Store
Thumbs.db
node_modules/

# Python
__pycache__/
*.pyc
.pytest_cache/
